#  Contact form → Discord 
# Discord channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
# Server-side only (never exposed to the browser).
DISCORD_WEBHOOK_URL=

#  Admin panel: Discord login 
# https://discord.com/developers/applications → your app → OAuth2
# Add redirect: https://<your-domain>/api/auth/callback (and http://localhost:3000/api/auth/callback for dev)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: override the redirect URI if the auto-detected origin is wrong.
DISCORD_REDIRECT_URI=

# Who may log in (any match grants access):
# Server whose owner / Administrator / Manage Server members are admins
DISCORD_GUILD_ID=
# Comma-separated role IDs in that server that grant admin access
DISCORD_ADMIN_ROLE_IDS=
# Comma-separated Discord user IDs that always have access
DISCORD_ADMIN_USER_IDS=

# Random 32+ char string used to sign admin sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

#  Content storage for admin edits 
# Vercel → Storage → Marketplace → Upstash (Redis). Connecting it to the project
# sets these automatically. Without them the site uses config/content.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
